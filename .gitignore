apiKey.txt
*.key
.env

# Compiled binaries. The root one is the main build output; web/pogo is a
# stray copy that turned out to be an ar archive. Both are build artifacts.
/pogo
/web/pogo

web/ui/node_modules/

# OS / editor cruft.
.DS_Store
*.swp

# Local agent tooling settings (personal permissions, not portable).
.claude/

# web/ui/dist is deliberately NOT ignored: it is embedded into the binary, so a
# checkout has to contain it for `go build` to work. Rebuild it with
# `cd web/ui && npm run build` whenever the front end changes.
identity-yw/
users.json

# Deployment credentials (compose env_file): 4 provider API keys, never shared.
deploy.env

# Windows build outputs; the Linux names above predate cross builds.
*.exe

# Local pogo runtime state (sessions, probes) from running a dev server here.
.pogo/
.tmp_probe_mcp/
.tmp_presentation.txt

# Build intermediates (e.g. pkg13 knowledge-provider assembly workspace).
/build/

# Repository-root dependencies installed by local browser tooling.
/node_modules/
