#!/opt/venv/bin/python3
"""docx-text <docx> [起块 止块] — 按文档顺序输出正文为 Markdown。

块 = 一个段落或一张表格（与 docx-info 的计数同口径）。标题转成 #
层级；表格转成管道表。输出超过字符预算时截断并标记，把块段切小重取。
"""

import sys
import os

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from docxlib import MAX_CHARS, DocxError, body_items, open_body, para_heading, para_text, table_rows  # noqa: E402

BUDGET = 120_000  # 一次输出的字符预算；超了就分页取


def md_table(rows):
    if not rows:
        return ""
    width = max(len(r) for r in rows)
    norm = [list(r) + [""] * (width - len(r)) for r in rows]
    cells = [[c.replace("|", "\\|").replace("\n", " ")[:200] for c in r] for r in norm]
    out = ["| " + " | ".join(cells[0]) + " |",
           "| " + " | ".join(["---"] * width) + " |"]
    out += ["| " + " | ".join(r) + " |" for r in cells[1:]]
    return "\n".join(out)


def main():
    if len(sys.argv) < 2 or len(sys.argv) > 4:
        print("usage: docx-text <docx> [起块 止块]", file=sys.stderr)
        return 2
    try:
        lo = int(sys.argv[2]) if len(sys.argv) > 2 else 1
        hi = int(sys.argv[3]) if len(sys.argv) > 3 else 10 ** 9
    except ValueError:
        print("docx-text: 起块和止块必须是正整数", file=sys.stderr)
        return 2
    if lo < 1 or hi < lo:
        print("docx-text: 块范围需要满足 1 <= 起块 <= 止块", file=sys.stderr)
        return 2
    try:
        root = open_body(sys.argv[1])
        out = []
        total = 0
        idx = 0
        for kind, item in body_items(root):
            idx += 1
            if idx < lo:
                continue
            if idx > hi:
                break
            if kind == "para":
                text = para_text(item).strip()
                lvl = para_heading(item)
                if not text:
                    continue
                line = ("#" * lvl + " " + text) if lvl else text
            else:
                line = md_table(table_rows(item))
            if total + len(line) > min(BUDGET, MAX_CHARS):
                out.append(f"\n[已截断：字符预算用尽，第 {idx} 块起请分批取]")
                break
            out.append(f"<!--{idx}-->")
            out.append(line)
            total += len(line)
        print("\n\n".join(out) if out else "(空范围)")
        return 0
    except DocxError as e:
        print(f"docx-text: {e}", file=sys.stderr)
        return 1
    except Exception as e:
        reason = " ".join(str(e).split())[:240]
        print(f"docx-text: docx 文档结构不可读取: {reason}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
